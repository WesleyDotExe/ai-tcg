{
  "name": "@ai-tcg/server",
  "version": "0.1.0",
  "description": "AI-TCG server: the match server (pairs connecting agents over WebSocket, drives a real match end to end through the engine, records the log) and the owner API (HTTP + JSON endpoints for the website, starting with the deck settings, over the economy store).",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "tsx src/cli.ts",
    "owner-api": "tsx src/ownerApiCli.ts",
    "demo:owner-api": "tsx src/dev/ownerApiDemo.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ladder": "tsx src/ladderCli.ts",
    "demo:ladder": "tsx src/dev/ladderDemo.ts",
    "season": "tsx src/seasonCli.ts",
    "demo:live-ladder": "tsx src/dev/liveLadderDemo.ts",
    "measure:first-seat": "tsx src/dev/firstSeatMeasure.ts",
    "demo:collection-asks": "tsx src/dev/collectionAsksApiDemo.ts",
    "demo:coins": "tsx src/dev/coinSkinsApiDemo.ts",
    "demo:replay-versions": "tsx src/dev/replayVersionsDemo.ts",
    "demo:live-feed-asks": "tsx src/dev/liveFeedAsksDemo.ts",
    "demo:speed-vote": "tsx src/dev/speedVoteDemo.ts",
    "demo:featured-viewers": "tsx src/dev/featuredViewersDemo.ts",
    "demo:play-time": "tsx src/dev/playTimeApiDemo.ts",
    "demo:notifications": "tsx src/dev/notificationsApiDemo.ts",
    "demo:stats": "tsx src/dev/statsApiDemo.ts",
    "measure:first-seat-ladder": "tsx src/dev/firstSeatLadder.ts"
  },
  "dependencies": {
    "@ai-tcg/economy": "*",
    "@ai-tcg/engine": "*",
    "@ai-tcg/protocol": "*",
    "tsx": "^4.23.13",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@ai-tcg/agents": "*",
    "@types/node": "^22.20.2",
    "@types/ws": "^8.5.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
